import re
from datetime import datetime
from lark import Lark
from lark.exceptions import UnexpectedCharacters

# ==========================================
# 1. GRAMÁTICA (RastreioLang)
# ==========================================
GRAMATICA = r"""
start: _token*
_token: RASTREIO | STATUS | CEP | EM | PESO | FRETE | VOLUMES | DESTINATARIO
      | TRANSPORTADORA | TRAJETO | SITUACAO | NOME_TRANSP
      | COD_RASTREIO | CEP_VALOR | DATA | HORA | MEDIDA | VALOR
      | DOC_CPF | EMAIL | NUMERO | TEXTO | SETA

// Palavras reservadas
RASTREIO.3:      /rastreio\b/i
STATUS.3:        /status\b/i
CEP.3:           /cep\b/i
EM.3:            /em\b/i
PESO.3:          /peso\b/i
FRETE.3:         /frete\b/i
VOLUMES.3:       /volumes\b/i
DESTINATARIO.3:  /destinat[aá]rio\b/i
TRANSPORTADORA.3: /transportadora\b/i
TRAJETO.3:       /trajeto\b/i

// Grupos
SITUACAO.4:      /(postado|em[ _]tr[aâ]nsito|saiu[ _]para[ _]entrega|entregue|devolvido|aguardando[ _]retirada)\b/i
NOME_TRANSP.3:   /(correios|sedex|pac|jadlog|loggi|mercado_envios)\b/i

// Literais estruturados
COD_RASTREIO.2:  /[A-Z]{2}\d{9}[A-Z]{2}\b/i
CEP_VALOR.2:     /\d{5}-\d{3}\b/
DATA.2:          /\d{2}\/\d{2}\/\d{4}\b/
HORA.2:          /([01]\d|2[0-3]):[0-5]\d\b/
MEDIDA.2:        /\d+(,\d+)?[ ]?(kg|g)\b/i
VALOR.2:         /R\$ ?(\d{1,3}(\.\d{3})+|\d+),\d{2}\b/
DOC_CPF.2:       /\d{3}\.\d{3}\.\d{3}-\d{2}\b/
EMAIL.4:         /[a-z0-9._+-]+@[a-z0-9-]+(\.[a-z0-9-]+)+/i
NUMERO.1:        /\d+/

// Texto e Strings
TEXTO:           /"[^"\n]*"/
SETA:            "->"

%ignore /#[^\n]*/
%ignore /[ \t\r\n]+/
"""

lexer = Lark(GRAMATICA, parser="lalr", lexer="basic")

# ==========================================
# 2. TOKENIZADOR E TRATAMENTO DE ERROS
# ==========================================
def tokenizar(texto):
    """Gera os tokens e captura erros léxicos."""
    try:
        return list(lexer.lex(texto))
    except UnexpectedCharacters as erro:
        raise ValueError(f"Erro Léxico na linha {erro.line}, coluna {erro.column}: caractere inesperado {erro.char!r}")

# ==========================================
# 3. MASCARAMENTO LGPD E CONVERSÕES
# ==========================================
def mascarar_cpf(v): return "***" + v[3:12] + "**"
def mascarar_email(v): 
    usuario, dominio = v.split("@")
    return usuario[0] + "***@" + dominio

def processar_tokens(tokens, aplicar_lgpd=True):
    """Extrai os dados reais dos tokens, aplicando LGPD se necessário."""
    encomenda = {}
    
    for i, t in enumerate(tokens):
        valor = str(t.value).strip('"')
        
        if t.type == "COD_RASTREIO":
            encomenda["codigo"] = valor
        elif t.type == "SITUACAO":
            encomenda["status"] = valor.replace("_", " ").title()
        elif t.type == "CEP_VALOR":
            encomenda["cep"] = valor[:5] + "-***" if aplicar_lgpd else valor
        elif t.type == "DOC_CPF":
            encomenda["cpf"] = mascarar_cpf(valor) if aplicar_lgpd else valor
        elif t.type == "EMAIL":
            encomenda["email"] = mascarar_email(valor) if aplicar_lgpd else valor
            
    return encomenda

# ==========================================
# 4. TESTES (Executados ao rodar o script)
# ==========================================
if __name__ == "__main__":
    print("🚀 Iniciando Analisador Léxico - RastreioLang\n")
    
    entrada_sucesso = 'RASTREIO BR123456789BR STATUS "saiu para entrega" CEP 01310-100 EM 10/09/2026 DESTINATARIO "Maria" 123.456.789-09 maria.souza@gmail.com'
    entrada_erro = 'RASTREIO BR123456789BR STATUS "erro de aspas'

    print("--- TESTE 1: Entrada Válida ---")
    try:
        tokens = tokenizar(entrada_sucesso)
        dados = processar_tokens(tokens, aplicar_lgpd=True)
        print(f"✅ Tokens extraídos com sucesso: {len(tokens)} tokens.")
        print("📦 Dados da Encomenda (LGPD Ativa):")
        for chave, valor in dados.items():
            print(f"  - {chave.capitalize()}: {valor}")
    except ValueError as e:
        print(f"❌ {e}")

    print("\n--- TESTE 2: Entrada Inválida (Erro Léxico) ---")
    try:
        tokenizar(entrada_erro)
    except ValueError as e:
        print(f"✅ Erro capturado com sucesso: {e}")
